# GEMINI_API_KEY: Required if adding optional Gemini features.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this portfolio is hosted.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Google account email authorized to sign in to /admin and upload media.
ADMIN_EMAIL="creative.nabiul@gmail.com"
